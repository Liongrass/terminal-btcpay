@using BTCPayServer.Client
@model BTCPayServer.Components.MainNav.MainNavViewModel

@* Server-wide, not store-scoped: litd is a property of the deployment, so this entry shows on every
   page of the Plugins menu rather than only inside a store. The permission attribute is what keeps it
   invisible to everyone but a server administrator - the controller enforces the same policy. *@
<li class="nav-item" permission="@Policies.CanModifyServerSettings">
    @* No explicit id or class: layout-menu-item writes both (id="menu-item-LightningTerminal", plus the
       active state), and setting either here renders a duplicate attribute. *@
    <a layout-menu-item="@LightningTerminalPlugin.MenuItemId" asp-area="" asp-controller="UILightningTerminal" asp-action="Index">
        <vc:icon symbol="logo-lightningterminal"/>
        <span text-translate="true">Lightning Terminal</span>
    </a>
</li>
