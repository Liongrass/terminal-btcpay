@model InstallBlocker

@* Shared by the landing screen and the instructions page so a blocker reads the same in both, and so
   a blocker that ships commands presents them exactly like the install instructions do - same copy
   button, same wrapping - rather than as a sentence with shell buried in it. *@
<span class="d-block">@Model.Message</span>

@if (Model.Command is { } command)
{
    <div class="d-flex justify-content-end mt-2 mb-1">
        <button type="button" class="btn btn-sm btn-secondary only-for-js clipboard-button"
                data-clipboard="@command"
                data-clipboard-confirm="@StringLocalizer["Copied"]">
            <vc:icon symbol="actions-copy"/>
            <span class="ms-1">Copy</span>
        </button>
    </div>
    <pre class="p-3 mb-0 rounded border bg-tile text-break" style="white-space: pre-wrap;"><code>@command</code></pre>
}
