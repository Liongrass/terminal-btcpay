@model InstallBlocker

@* Shared by the landing screen and the instructions page so a blocker reads the same in both. *@
<span class="d-block">@Model.Message</span>

@if (Model.Command is { } command)
{
    <div class="mt-2">
        <partial name="@LightningTerminalPlugin.HostCommandPartial" model="command"/>
    </div>
}
