@model TerminalSettingsViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel(LightningTerminalPlugin.MenuItemId, StringLocalizer["Connect to litd"]));
}

<div class="sticky-header align-items-start">
    <nav aria-label="breadcrumb" class="flex-grow-1">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Lightning Terminal</a></li>
            <li class="breadcrumb-item active" aria-current="page">Connect to litd</li>
        </ol>
        <h2 class="mb-0">@ViewData["Title"]</h2>
    </nav>
</div>
<partial name="_StatusMessage"/>

<div class="row">
    <div class="col-xl-8 col-xxl-constrain">
        <p class="text-muted">
            This litd was installed with BTCPay Server's own Lightning Terminal fragment, which keeps
            litd's macaroon in a volume this plugin cannot read. litd accepts its web UI password
            instead, so entering it here is enough to connect.
        </p>

        <p class="text-muted">
            Read it from a root shell on your BTCPay Server host:
        </p>
        <partial name="@LightningTerminalPlugin.HostCommandPartial"
                 model="@(". /etc/profile.d/btcpay-env.sh\ncat \"$BTCPAY_BASE_DIRECTORY/btcpayserver-docker/secrets/lit_password\"")"/>

        <form method="post" class="mt-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="UiPassword" class="form-label"></label>
                <input asp-for="UiPassword" type="password" class="form-control" autocomplete="off"
                       placeholder="@(Model.HasUiPassword ? "Stored — type a new one to replace it" : null)"/>
                <div class="form-text">
                    @if (Model.HasUiPassword)
                    {
                        <text>A password is stored. Leaving this empty keeps it.</text>
                    }
                    else
                    {
                        <text>The same password that opens litd's web UI@(Model.UpstreamUrl is null ? "" : " at " + Model.UpstreamUrl).</text>
                    }
                </div>
                <span asp-validation-for="UiPassword" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>

        @if (Model.HasUiPassword)
        {
            <hr class="my-4"/>
            <form method="post" asp-action="ForgetUiPassword">
                <button type="submit" class="btn btn-outline-danger btn-sm"
                        onclick="return confirm('Forget the stored password? The plugin will stop being able to reach litd.');">
                    Forget stored password
                </button>
            </form>
        }

        @* Said plainly rather than buried: this path is only as private as the Docker network, and an
           operator choosing it should know that before typing a node credential into the box. *@
        <div class="alert alert-warning mt-4">
            <strong class="d-block mb-1">This connection is not encrypted.</strong>
            BTCPay's fragment gives litd no TLS port on the Docker network, so the password and
            everything asked of litd cross that network in the clear. Nothing leaves the deployment, and
            it is the same port litd already serves its web UI on. To avoid it entirely, switch to this
            plugin's own fragment, which mounts litd's macaroon and talks TLS &mdash; the option is on
            the <a asp-action="Index">Lightning Terminal</a> page.
        </div>
    </div>
</div>

@section PageFootContent {
    <partial name="_ValidationScriptsPartial"/>
}
