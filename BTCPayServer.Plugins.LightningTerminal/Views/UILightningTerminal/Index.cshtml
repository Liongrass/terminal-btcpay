@model TerminalIndexViewModel
@{
    ViewData.SetLayoutModel(new LayoutModel(LightningTerminalPlugin.MenuItemId, StringLocalizer["Lightning Terminal"]));

    var status = Model.Status;
    // NeedsUiPassword first: litd is up, this plugin just has no credential for it yet, which reads
    // differently from litd being down.
    var (dot, headline) = status.NeedsUiPassword
        ? ("pending", "Running, not connected")
        : !status.Installed
            ? ("disabled", "Not installed")
            : status.Healthy
                ? ("enabled", "Running")
                : status.Running
                    ? ("pending", "Running with errors")
                    : ("disabled", "Installed, but not running");
}

<div class="sticky-header">
    <h2 class="my-1">@ViewData["Title"]</h2>
    @* Running implies Installed - LitdStatus only reports Running for a litd that answered - so this
       one condition covers both. target=_blank so the plugin page survives the click; the action
       redirects that new tab straight to Terminal with the pairing phrase in the URL fragment. *@
    @if (status.Running)
    {
        <form method="post" asp-action="Connect" target="_blank">
            <button type="submit" class="btn btn-primary">Connect to Terminal</button>
        </form>
    }
</div>
<partial name="_StatusMessage"/>

@if (!Model.DockerDeployment)
{
    <div class="alert alert-warning mb-4">
        This BTCPay Server is not running from a
        <a href="https://github.com/btcpayserver/btcpayserver-docker" target="_blank" rel="noreferrer noopener">btcpayserver-docker</a>
        deployment. Lightning Terminal is installed as a container alongside BTCPay's own LND, so this
        plugin has nothing to manage here and the instructions below will not apply.
    </div>
}

<div class="widget mb-4">
    <div class="d-flex align-items-center justify-content-between">
        <h5 class="mb-0">
            <span class="me-2 btcpay-status btcpay-status--@dot"></span>@headline
        </h5>
        @if (status.LndState is not null)
        {
            <span class="text-muted">LND: <code>@status.LndState</code></span>
        }
    </div>

    @if (status.Error is not null)
    {
        <div class="alert alert-danger mt-3 mb-0">@status.Error</div>
    }

    @if (status.NeedsUiPassword)
    {
        <hr/>
        <div class="alert alert-info mb-3">
            <strong class="d-block mb-1">litd is running, installed by BTCPay's own fragment.</strong>
            That fragment keeps litd's macaroon in a volume this plugin cannot read, so it needs litd's
            web UI password instead before it can report on sessions, accounts or subsystems.
        </div>
        <a asp-action="Settings" class="btn btn-primary">Connect to litd</a>
        <p class="text-muted small mb-0 mt-3">
            Prefer not to store the password? <a asp-action="Instructions" asp-route-operation="@TerminalOperation.Switch">Switch
            to this plugin's fragment</a> instead &mdash; it mounts litd's macaroon, talks TLS, and keeps
            your accounts, sessions and history.
        </p>
    }
    else if (!status.Installed)
    {
        <hr/>
        @* Only when there is no litd here at all - an upstream install is handled above. *@
        @if (status.NotFound)
        {
            <p class="text-muted">
                Litd includes Loop, Pool, Taproot Assets and Faraday. Through Lightning Node Connect (LNC)
                you can connect to your node from
                <a href="@TerminalConnect.BaseUrl" target="_blank" rel="noreferrer noopener">Lightning Terminal</a>
                or a mobile wallet of your choice. This plug-in guides you through how to add
                <code>litd</code> to your BTCPay Server, connect to Lightning Terminal and manages your
                remote connections.
            </p>
        }

        @if (status.Backend.Blocker is { } blocker)
        {
            <div class="alert alert-danger mb-0">
                <strong class="d-block mb-1">Lightning Terminal cannot be installed on this deployment.</strong>
                <partial name="@LightningTerminalPlugin.BlockerPartial" model="blocker"/>
            </div>
        }
        else
        {
            <p class="mb-3">
                <span class="me-2 btcpay-status btcpay-status--enabled"></span>LND is installed and running.
            </p>

            <p class="text-muted mb-1">
                You may now install Lightning Terminal. Copy the code snippet below and run it as root in
                the command line of your BTCPay Server installation.
            </p>
            <p class="text-muted mb-3">
                Once BTCPay Server has finished restarting itself, you may come back to this page.
            </p>
            <partial name="@LightningTerminalPlugin.HostCommandPartial" model="Model.InstallCommand"/>
        }

        @* Uninstalling keeps litd's data volume, and once /lit is unmounted nothing here can tell
           whether one is still lying around - so this is offered quietly rather than asserted. Without
           it, Wipe would be unreachable at exactly the point the uninstall page says to use it, since
           the Maintenance widget only renders while litd is installed. Not shown for an upstream
           install, where wiping would take out a litd that is currently running. *@
        @if (status.NotFound)
        {
            <p class="text-muted small mb-0 mt-4">
                Uninstalling litd keeps its data. If you have leftovers from an earlier install, you can
                <a asp-action="Instructions" asp-route-operation="@TerminalOperation.Wipe">remove them for good</a>.
            </p>
        }
    }
</div>

@if (status.Installed && !status.NeedsUiPassword)
{
    <div class="widget mb-4">
        <h5 class="mb-3">Subsystems</h5>
        @if (status.SubServers.Count == 0)
        {
            <p class="text-muted mb-0">
                litd has not reported on its subsystems. That is expected while it is down or still starting.
            </p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                    <tr>
                        <th>Subsystem</th>
                        <th>Status</th>
                        <th>Detail</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var sub in status.SubServers)
                    {
                        var (subDot, subLabel) = sub switch
                        {
                            { HasError: true } => ("disabled", "Error"),
                            { Disabled: true } => ("disabled", "Disabled"),
                            { Running: true } => ("enabled", "Running"),
                            _ => ("pending", "Not running")
                        };
                        <tr>
                            <td><code>@sub.Name</code></td>
                            <td><span class="me-2 btcpay-status btcpay-status--@subDot"></span>@subLabel</td>
                            <td class="text-break">
                                @if (sub.HasError)
                                {
                                    <span class="text-danger">@sub.Error</span>
                                }
                                else if (!string.IsNullOrEmpty(sub.CustomStatus))
                                {
                                    <span class="text-muted">@sub.CustomStatus</span>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="widget mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="mb-0">Sessions</h5>
            <a asp-action="NewSession" class="btn btn-secondary btn-sm">Generate pairing phrase</a>
        </div>
        <p class="text-muted">
            <strong>Connect to Terminal</strong> mints an admin session with the usual defaults and opens
            Terminal on the web with its phrase already filled in. <strong>Generate pairing phrase</strong>
            lets you choose the label, type, lifetime and mailbox, and hands you the phrase for any LNC
            client. A phrase pairs one client, once; revoke a session to cut that client off.
        </p>

        @if (Model.SessionsError is not null)
        {
            <div class="alert alert-warning">@Model.SessionsError</div>
        }
        else if (Model.Sessions.Count == 0)
        {
            <p class="text-muted mb-0">No sessions yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                    <tr>
                        <th>Label</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Expires</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var session in Model.Sessions)
                    {
                        <tr>
                            <td class="text-break">@session.Label</td>
                            <td>@session.Type</td>
                            <td>@session.State</td>
                            <td>@session.Expiry.ToDisplayDateTime()</td>
                            <td class="text-end text-nowrap">
                                @if (session.PairingUrl is { } pairingUrl)
                                {
                                    <a href="@pairingUrl" target="_blank" rel="noreferrer noopener"
                                       class="btn btn-link btn-sm p-0 me-3">Open in Terminal</a>
                                }
                                @if (session.Active)
                                {
                                    <form method="post" asp-action="RevokeSession" class="d-inline">
                                        <input type="hidden" name="localPublicKey" value="@session.LocalPublicKey"/>
                                        <button type="submit" class="btn btn-link btn-sm p-0 text-danger"
                                                onclick="return confirm('Revoke this session? Any browser paired with it loses access immediately.');">
                                            Revoke
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="widget mb-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="mb-0">Accounts</h5>
            <a asp-action="NewAccount" class="btn btn-secondary btn-sm">Create new account</a>
        </div>
        <p class="text-muted">
            An account caps how much can be spent through it. Pair one with a Custodial session to hand
            someone a budget rather than your node.
        </p>

        @if (Model.AccountsError is not null)
        {
            <div class="alert alert-warning">@Model.AccountsError</div>
        }
        else if (Model.Accounts.Count == 0)
        {
            <p class="text-muted mb-0">No accounts yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                    <tr>
                        <th>Account</th>
                        <th class="text-end">Balance</th>
                        <th>Expires</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var account in Model.Accounts)
                    {
                        <tr>
                            <td class="text-break">
                                <a asp-action="Account" asp-route-id="@account.Id">@account.Display</a>
                            </td>
                            <td class="text-end">@account.CurrentBalanceSats.ToString("N0") sats</td>
                            <td>
                                @if (account.Expiry is { } expiry)
                                {
                                    <span class="@(account.HasExpired ? "text-danger" : null)">
                                        @expiry.ToDisplayDate()
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">Never</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <form method="post" asp-action="RemoveAccount" asp-route-id="@account.Id" class="d-inline">
                                    <button type="submit" class="btn btn-link btn-sm p-0 text-danger"
                                            onclick="return confirm('Remove @account.Display? Anything paired to it stops working.');">
                                        Remove
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="widget">
        <h5 class="mb-3">Maintenance</h5>
        <div class="d-flex flex-wrap gap-2">
            @if (status.LogAvailable)
            {
                <a asp-action="Logs" class="btn btn-secondary">Download litd logs</a>
            }
            else
            {
                <button type="button" class="btn btn-secondary" disabled
                        title="litd has not written a log file yet">
                    Download litd logs
                </button>
            }
            @* Uninstall and wipe drive this plugin's own fragment by name, so they would do nothing
               useful against an install that BTCPay's fragment put here. *@
            @if (status.UpstreamOnly)
            {
                <a asp-action="Settings" class="btn btn-outline-secondary">Connection settings</a>
                <a asp-action="Instructions" asp-route-operation="@TerminalOperation.Switch" class="btn btn-outline-secondary">
                    Switch to the headless install
                </a>
            }
            else
            {
                <a asp-action="Instructions" asp-route-operation="@TerminalOperation.Uninstall" class="btn btn-outline-secondary">
                    Uninstall litd
                </a>
                <a asp-action="Instructions" asp-route-operation="@TerminalOperation.Wipe" class="btn btn-outline-danger">
                    Wipe litd data
                </a>
            }
        </div>
        @if (status.UpstreamOnly)
        {
            <p class="text-muted small mb-0 mt-3">
                litd here came from BTCPay Server's own fragment, so this plugin does not manage its
                installation. Switching moves it to this plugin's fragment, keeping accounts, sessions
                and history, and replaces the stored password with a mounted macaroon over TLS.
            </p>
        }
        else
        {
            <p class="text-muted small mb-0 mt-3">
                Uninstalling removes the <code>litd</code> container but keeps its data, so re-installing
                later picks up right where you left off. Wiping destroys that data permanently. Neither
                touches LND itself, its channels or its funds.
            </p>
        }
    </div>
}
